generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())

  predictions        MatchPrediction[]
  extraPredictions   ExtraPrediction?
  comments           MatchComment[]
  pushSubscriptions  PushSubscription[]
  minigameScores     MinigameScore[]
  beersDrunk         BeerConfirmation[] @relation("drinker")
  beersWitnessed     BeerConfirmation[] @relation("witness")
}

model MatchComment {
  id          String   @id @default(cuid())
  userId      String
  matchNumber Int
  message     String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([matchNumber, createdAt])
}

model MatchPrediction {
  id            String  @id @default(cuid())
  userId        String
  matchNumber   Int
  homeScore     Int
  awayScore     Int
  advancingTeam String?
  jokerUsed     Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, matchNumber])
}

model ExtraPrediction {
  id                    String @id @default(cuid())
  userId                String @unique
  topScorer             String @default("")
  belgianTopScorer      String @default("")
  worldChampion         String @default("")
  topScorerGoals        Int    @default(0)
  topScorerFirstGoalMin Int    @default(0)

  user User @relation(fields: [userId], references: [id])
}

model ActualResult {
  id            String  @id @default(cuid())
  matchNumber   Int     @unique
  homeScore     Int
  awayScore     Int
  advancingTeam String?
}

model PushSubscription {
  id        String @id @default(cuid())
  userId    String
  endpoint  String @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model MinigameScore {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([score(sort: Desc)])
}

model BeerConfirmation {
  id          String   @id @default(cuid())
  drinkerId   String
  reason      String
  claimedAt   DateTime?
  witnessId   String?
  witnessedAt DateTime?

  drinker User  @relation("drinker", fields: [drinkerId], references: [id])
  witness User? @relation("witness", fields: [witnessId], references: [id])

  @@unique([drinkerId, reason])
}
